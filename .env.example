# Local Docker Compose values only. Use secret management outside local demo use.
LOCKSTEP_DB_NAME=lockstep
LOCKSTEP_DB_USER=lockstep_app
LOCKSTEP_DB_PASSWORD=replace-for-shared-environments
LOCKSTEP_BACKEND_PORT=8081
LOCKSTEP_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Demo data is opt-in. Choose unique passwords of at least 12 characters.
LOCKSTEP_SPRING_PROFILES_ACTIVE=
LOCKSTEP_DEMO_CUSTOMER_EMAIL=customer@lockstep.test
LOCKSTEP_DEMO_CUSTOMER_PASSWORD=
LOCKSTEP_DEMO_ADMIN_EMAIL=admin@lockstep.test
LOCKSTEP_DEMO_ADMIN_PASSWORD=

